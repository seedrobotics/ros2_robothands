<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>seed_hand_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level launch files for Seed Robotics hands: hand driver plus
    optional in-hand FTS sensors, selected by side. Contains no nodes of
    its own.
  </description>
  <maintainer email="marco@seedrobotics.com">Marco</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>seed_hand_driver</exec_depend>
  <exec_depend>ros2_sensor_pkg</exec_depend>
  <exec_depend>seed_rh8d_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
