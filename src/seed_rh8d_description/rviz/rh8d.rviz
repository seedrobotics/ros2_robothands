Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Cell Size: 0.05
      Name: Grid
      Plane Cell Count: 10
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Marker Scale: 0.15
      Name: TF
    - Class: rviz_common/Group
      Enabled: true
      Name: Fingertip forces right
      Displays:
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: thumb
          Force Arrow Scale: 0.01
          Force Color: 204; 51; 51
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/right/fingertip/thumb/wrench
          Value: true
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: index
          Force Arrow Scale: 0.01
          Force Color: 51; 102; 204
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/right/fingertip/index/wrench
          Value: true
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: middle
          Force Arrow Scale: 0.01
          Force Color: 51; 204; 102
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/right/fingertip/middle/wrench
          Value: true
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: ring
          Force Arrow Scale: 0.01
          Force Color: 230; 153; 51
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/right/fingertip/ring/wrench
          Value: true
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: little
          Force Arrow Scale: 0.01
          Force Color: 153; 102; 204
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/right/fingertip/little/wrench
          Value: true
    - Class: rviz_common/Group
      Enabled: true
      Name: Fingertip forces left
      Displays:
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: thumb
          Force Arrow Scale: 0.01
          Force Color: 204; 51; 51
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/left/fingertip/thumb/wrench
          Value: true
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: index
          Force Arrow Scale: 0.01
          Force Color: 51; 102; 204
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/left/fingertip/index/wrench
          Value: true
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: middle
          Force Arrow Scale: 0.01
          Force Color: 51; 204; 102
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/left/fingertip/middle/wrench
          Value: true
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: ring
          Force Arrow Scale: 0.01
          Force Color: 230; 153; 51
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/left/fingertip/ring/wrench
          Value: true
        - Class: rviz_default_plugins/Wrench
          Enabled: true
          Name: little
          Force Arrow Scale: 0.01
          Force Color: 153; 102; 204
          Torque Arrow Scale: 0
          Arrow Width: 0.008
          History Length: 1
          Topic:
            Value: /rh8d/left/fingertip/little/wrench
          Value: true
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.6
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.2
      Name: Current View
      Pitch: 0.3
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
